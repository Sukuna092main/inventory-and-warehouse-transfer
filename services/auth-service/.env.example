PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=auth_db
DB_USERNAME=auth_user
DB_PASSWORD=replace_with_your_local_auth_user_password

# HTTP Auth server only; generate 32 random bytes encoded as 64 hex characters.
# Not required for migrations or seed:admin.
JWT_SECRET=

# Only used by pnpm seed:admin. Set your own password (8-128 characters).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD="pass@word123"
